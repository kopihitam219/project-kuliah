{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "regions": [
        "sin1"
    ],
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0",
            "maxDuration": 30
        }
    },
    "routes": [
        {
            "src": "/index\\.php",
            "dest": "/api/index.php"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
